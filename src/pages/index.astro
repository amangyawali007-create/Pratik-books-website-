<a class="btn p fab" href={wa()} target="_blank" rel="noopener">WhatsApp</a>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
  gsap.registerPlugin(ScrollTrigger);
  const k = matchMedia('(max-width: 900px)').matches ? 0.5 : 1;
  document.querySelectorAll<HTMLElement>('.fl').forEach((el, i) => {
    const x = +el.dataset.x! * k, y = +el.dataset.y! * k, r = +el.dataset.r! * k;
    gsap.fromTo(el,
      { x: -x * 0.4, y: -y * 0.4, rotation: -r * 0.4, scale: 0.92, opacity: 0 },
      { x, y, rotation: r, scale: 1, opacity: 1, ease: 'none',
        scrollTrigger: { trigger: el.parentElement, start: 'top bottom', end: 'bottom top', scrub: 0.6 + (i % 4) * 0.3 } });
    gsap.to(el, { opacity: 0, ease: 'none',
      scrollTrigger: { trigger: el.parentElement, start: '70% top', end: 'bottom top', scrub: true } });
  });
}
</script>

<style is:global>
:root{--bg:#FFFBEA;--y:#FFD84A;--y2:#FFC928;--y3:#FFF1A8;--ink:#171717;--navy:#162033;--mute:#6A6A6A;--line:rgba(22,32,51,.09);--safe-t:env(safe-area-inset-top,0px)}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:90px}
body{font:400 17px/1.6 "DM Sans",system-ui,sans-serif;color:var(--ink);background:var(--bg);
background-image:linear-gradient(90deg,transparent 71px,rgba(226,92,92,.22) 71px,rgba(226,92,92,.22) 73px,transparent 73px),repeating-linear-gradient(transparent 0 35px,var(--line) 35px 36px);overflow-x:hidden;padding-bottom:env(safe-area-inset-bottom,0px)}
h1,h2,h3{font-family:Fraunces,Georgia,serif;font-weight:800;line-height:1.02;color:var(--navy);letter-spacing:-.02em}
a{color:inherit;text-decoration:none}
:focus-visible{outline:3px solid var(--navy);outline-offset:3px}
.wrap{max-width:1120px;margin:0 auto;padding:0 28px 0 clamp(28px,8vw,110px);position:relative;z-index:1}
section{position:relative;padding:110px 0;overflow:hidden}
.fl{position:absolute;pointer-events:none;will-change:transform;z-index:0;filter:drop-shadow(3px 6px 4px rgba(22,32,51,.16))}
.fl svg{width:100%;height:100%}
/* header */
header{position:sticky;top:0;z-index:50;padding-top:var(--safe-t);background:rgba(255,251,234,.88);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;max-width:1240px;margin:0 auto;padding:12px 28px}
nav{display:flex;gap:26px;font-weight:500;font-size:15px}
nav a:hover{text-decoration:underline wavy var(--y2);text-underline-offset:6px}
.brand{text-align:center;font-family:Fraunces,serif;line-height:1}
.brand b{display:block;font-size:30px;font-weight:800;color:var(--navy)}
.brand span{font-size:12px;font-weight:600;letter-spacing:.14em;color:var(--mute)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 24px;border-radius:999px;font-weight:700;font-size:16px;border:2px solid var(--navy);transition:transform .25s,box-shadow .25s,background .25s}
.btn i{font-style:normal;transition:transform .25s}
.btn:hover{transform:translateY(-2px);box-shadow:0 4px 0 var(--navy)}
.btn:hover i{transform:translateX(5px)}
.btn.p{background:var(--y);color:var(--navy)}
.btn.s{background:transparent}
.hd-cta{justify-self:end;padding:10px 18px;font-size:14px}
/* hero */
#home{min-height:calc(100svh - 70px);display:flex;align-items:center;padding:60px 0 90px}
h1{font-size:clamp(46px,8.2vw,112px)}
h1 em{font-style:normal;position:relative;white-space:nowrap}
h1 em svg{position:absolute;left:0;bottom:-.14em;width:100%;height:.28em;overflow:visible}
.lead{max-width:520px;margin:30px 0 36px;font-size:20px;color:#333}
.hand{font-family:Caveat,cursive;font-size:26px;color:var(--navy);position:absolute;white-space:nowrap}
.ctas{display:flex;gap:14px;flex-wrap:wrap}
/* categories */
h2{font-size:clamp(36px,5.4vw,66px)}
.sub{max-width:520px;margin-top:16px;color:var(--mute)}
.cats{display:grid;grid-template-columns:repeat(6,1fr);gap:34px 30px;margin-top:70px}
.cat{grid-column:span 2;display:flex;flex-direction:column;padding:26px 24px 22px;background:#fff;border:2px solid var(--navy);border-radius:6px 22px 8px 18px;box-shadow:5px 6px 0 var(--y);transition:transform .35s,box-shadow .35s;position:relative}
.cat:nth-child(2){margin-top:34px;transform:rotate(.8deg)}
.cat:nth-child(3){transform:rotate(-.7deg)}
.cat:nth-child(5){margin-top:30px;transform:rotate(-.6deg)}
.cat:nth-child(6){transform:rotate(.6deg)}
.cat:hover{transform:translateY(-4px) scale(1.01) rotate(0);box-shadow:7px 10px 0 var(--y2)}
.cat .ic{height:110px;display:flex;align-items:flex-end;gap:2px;margin-bottom:14px;transition:transform .4s}
.cat:hover .ic{transform:translate(4px,-4px) rotate(-2deg)}
.cat .ic svg{height:100%;width:auto;aspect-ratio:1}
/* let wide icons (pencil, brush) shrink instead of pushing the card past the screen */
.cat{min-width:0}.cat .ic svg{min-width:0}
.cat h3{font-size:30px}
.cat p{margin:8px 0 18px;color:#444;font-size:16px}
.cat a{margin-top:auto;font-weight:700;color:var(--navy);display:inline-flex;gap:8px;border-bottom:3px solid var(--y);align-self:flex-start}
.cat a i{font-style:normal;transition:transform .25s}
.cat a:hover i{transform:translateX(5px)}
/* about */
#about .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
.note{background:var(--y3);padding:38px 34px;transform:rotate(2deg);box-shadow:6px 10px 0 rgba(22,32,51,.1);position:relative;font-size:18px}
.note:before{content:"";position:absolute;top:-14px;left:50%;width:22px;height:22px;border-radius:50%;background:#E25C5C;box-shadow:0 4px 0 rgba(0,0,0,.18)}
.note .hand{position:static;display:block;margin-top:16px}
#about h2 u{text-decoration:none;background:linear-gradient(transparent 62%,var(--y) 62% 90%,transparent 90%)}
/* whatsapp */
.wa{background:var(--navy);color:#fff;border-radius:10px 40px 10px 40px;padding:70px clamp(28px,6vw,80px);position:relative;overflow:hidden}
.wa h2{color:#fff}.wa p{max-width:520px;margin:18px 0 30px;color:#d9deea}
.wa .btn{background:var(--y);color:var(--navy);border-color:var(--y)}
.wa .num{margin-top:22px;font-weight:500;color:var(--y3)}
/* visit */
.visit{display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:start}
address{font-style:normal;margin:24px 0}
address strong{font-family:Fraunces,serif;font-size:24px;color:var(--navy)}
.ctas.v .btn{padding:12px 20px;font-size:15px}
.mapcard{background:#fff;border:2px solid var(--navy);border-radius:20px 6px 20px 6px;padding:22px;box-shadow:6px 7px 0 var(--y);transform:rotate(-1deg)}
.mapcard svg{width:100%;height:auto;display:block}
.mapcard text{font-family:Caveat,cursive;font-weight:600;fill:var(--navy)}
.mapcard p{font-family:Caveat,cursive;font-size:24px;margin-top:8px;color:var(--navy)}
/* footer */
footer{background:var(--y);color:var(--navy);padding:60px 0 100px;position:relative;z-index:2}
.fg{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:36px}
footer .brand{text-align:left}
footer .brand b{font-size:36px}footer .brand span{color:var(--navy)}
footer h3{font-size:18px;margin-bottom:10px}
footer li{list-style:none;padding:2px 0}footer ul{padding:0}
footer a:hover{text-decoration:underline}
.tag{font-family:Caveat,cursive;font-size:26px;margin-top:14px}
.fab{display:none}
@media (max-width:900px){
 nav{display:none}.bar{grid-template-columns:1fr auto}.brand{text-align:left}
 .cats{grid-template-columns:1fr 1fr}.cat{grid-column:auto;margin-top:0!important}
 #about .wrap,.visit,.fg{grid-template-columns:1fr}
 .t-hide{display:none}
}
@media (max-width:600px){
 body{font-size:16px;background-image:linear-gradient(90deg,transparent 21px,rgba(226,92,92,.22) 21px,rgba(226,92,92,.22) 23px,transparent 23px),repeating-linear-gradient(transparent 0 31px,var(--line) 31px 32px)}
 .wrap{padding:0 20px 0 38px}section{padding:76px 0}
 .cats{grid-template-columns:1fr}.hd-cta{display:none}.bar{grid-template-columns:1fr}.brand{text-align:center}
 .m-hide{display:none}.lead{font-size:18px}
 .fab{display:inline-flex;position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:60;box-shadow:0 5px 14px rgba(22,32,51,.3);background:var(--y);padding:12px 20px}
 .hand.hero-h{display:none}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
</style>
</body>
</html>
