  <div><h3>Pages</h3><ul><li><a href="#home">Home</a></li><li><a href="#categories">Categories</a></li><li><a href="#about">About</a></li><li><a href="#visit">Visit</a></li><li><a href="#contact">Contact</a></li></ul></div>
 </div>
