---
const SHOP = 'Pratik Books & Stationers';
const WA_NUM = '9779848421318';
const MAPS = 'https://www.google.com/maps/search/?api=1&query=Pratik+Books+%26+Stationers+Kanchi+Bazar+Tikapur';
const title = `${SHOP} | Stationery Shop in Tikapur`;
const description = 'Pratik Books & Stationers in Kanchi Bazar, Tikapur offers books, school stationery, art supplies, office supplies, sports materials and more. Contact us directly through WhatsApp.';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;

// WhatsApp deep link with a pre-filled message, built at compile time.
const wa = (cat = '') =>
  `https://wa.me/${WA_NUM}?text=${encodeURIComponent(
    cat
      ? `Hello ${SHOP},\nI am interested in your ${cat} category.\nPlease share available items and details.`
      : `Hello ${SHOP},\nI visited your website and would like to know more about your available items.`,
  )}`;

// [symbol id, viewBox, aspect-ratio] — viewBox/ratio only for non-square art
type Icon = [string, string?, number?];
const cats: { name: string; desc: string; label: string; icons: Icon[] }[] = [
  { name: 'Books', desc: 'School books, reference books, notebooks and more.', label: 'Stack of books and a notebook', icons: [['book'], ['notebook']] },
  { name: 'Stationery', desc: 'Pens, pencils, markers, rulers, erasers and everyday essentials.', label: 'Pencil, eraser and paper clip', icons: [['pencil', '0 0 120 30', 4], ['eraser', '0 0 70 36', 2], ['clip', '0 0 40 90', 0.45]] },
  { name: 'Art & Craft', desc: 'Colours, sketchbooks, brushes, paint and creative materials.', label: 'Paintbrush and star', icons: [['brush', '0 0 130 24', 5.4], ['star', '0 0 80 80']] },
  { name: 'School Essentials', desc: 'Bags, geometry sets, notebooks, bottles and school-use items.', label: 'School bag and notebook', icons: [['bag'], ['notebook']] },
  { name: 'Office Supplies', desc: 'Files, folders, staplers, printer paper and desk essentials.', label: 'Sticky note and paper clip', icons: [['sticky'], ['clip', '0 0 40 90', 0.45]] },
  { name: 'Sports', desc: 'Football, badminton, shuttlecocks and school sports materials.', label: 'Football and shuttlecock', icons: [['ball'], ['shuttle', '0 0 60 90', 0.66]] },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Store',
  name: SHOP,
  description: 'Books, stationery, art supplies, office supplies and sports materials in Tikapur.',
  ...(canonical && { url: canonical }),
  telephone: ['+9779848421318', '+97791560311'],
  address: { '@type': 'PostalAddress', streetAddress: 'Kanchi Bazar', addressLocality: 'Tikapur', addressRegion: 'Kailali', addressCountry: 'NP' },
  areaServed: ['Tikapur', 'Kailali'],
  sameAs: [`https://wa.me/${WA_NUM}`],
};
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="keywords" content="stationery shop in Tikapur, books shop in Tikapur, book store Tikapur, school supplies Tikapur, office supplies Tikapur, art supplies Tikapur, sports materials Tikapur, stationery Kailali, books and stationery Kailali">
{canonical && <link rel="canonical" href={canonical}>}
{canonical && <meta property="og:url" content={canonical}>}
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content="Books, stationery, art supplies, office supplies and sports materials in Kanchi Bazar, Tikapur.">
<meta property="og:locale" content="en_NP">
<meta name="theme-color" content="#FFD84A">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
